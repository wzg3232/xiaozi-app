HOST=0.0.0.0
PORT=4200
DB_PATH=./data/ichat.sqlite
# Set an HTTPS URL for the final mobile build, or enter it on the login screen.
# ALLOWED_ORIGINS=https://chat.example.com,http://localhost,capacitor://localhost
# Demo accounts are created only by `npm run demo`; keep demo mode off on a public server.

# Uploaded image files; default is uploads/ next to DB_PATH. Back up both.
# MEDIA_DIR=./data/uploads
# Set only behind a loopback reverse proxy that overwrites X-Real-IP.
# TRUST_PROXY=loopback
